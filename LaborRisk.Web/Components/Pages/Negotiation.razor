@page "/negotiation"
@using LaborRisk.Domain
@using LaborRisk.LegalEngine
@using Microsoft.AspNetCore.Components.Web
@inject SimulationService SimService
@rendermode InteractiveServer

<PageTitle>Huấn luyện & Cố vấn Đàm phán Hợp đồng</PageTitle>

<div class="container my-4" style="max-width: 800px;">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="fw-bold text-primary mb-0">Chương trình Huấn luyện Ký Hợp đồng</h3>
        <span class="badge bg-primary fs-6">Tổng điểm: @totalScore / 100</span>
    </div>

    @if (currentIndex < scenarios.Count)
    {
        var currentScenario = scenarios[currentIndex];

        <div class="card shadow-sm mb-4 border-primary">
            <div class="card-header bg-primary text-white fw-bold">
                Phần @(currentIndex + 1)/5: @currentScenario.Category
            </div>
            <div class="card-body">
                <h5 class="card-title text-dark">Điều khoản trong hợp đồng:</h5>
                <blockquote class="blockquote p-3 bg-light rounded border-start border-4 border-warning fs-6">
                    "@currentScenario.ClauseText"
                </blockquote>

                <p class="fw-bold mt-3">Bạn quyết định xử lý điều khoản này như thế nào?</p>

                <!-- Bộ 3 nút quyết định chiến lược -->
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-danger flex-fill py-2 fw-bold" @onclick='() => HandleUserChoice("TuChoi")' disabled="@isProcessing">
                        ❌ Từ chối
                    </button>
                    <button type="button" class="btn btn-warning text-dark flex-fill py-2 fw-bold" @onclick='() => HandleUserChoice("DamPhan")' disabled="@isProcessing">
                        💡 Đàm phán lại
                    </button>
                    <button type="button" class="btn btn-success flex-fill py-2 fw-bold" @onclick='() => HandleUserChoice("DongY")' disabled="@isProcessing">
                        ✅ Đồng ý Ký
                    </button>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(aiFeedback))
        {
            <div class="card shadow-sm mb-4 border-info">
                <div class="card-header bg-info text-white fw-bold">
                    🤖 Nhận xét & Chiến lược từ AI Coach
                </div>
                <div class="card-body">
                    <!-- Đánh giá tổng quan -->
                    <p style="white-space: pre-wrap;" class="fs-6">@aiFeedback</p>

                    <div class="alert alert-secondary mt-2 mb-3 small">
                        <strong>Căn cứ pháp lý:</strong> @currentScenario.Explanation
                    </div>

                    <!-- Khung hiển thị Kịch bản đàm phán sâu nếu điều khoản cần đàm phán hoặc người dùng chọn đàm phán -->
                    @if (userChoice == "DamPhan" || currentScenario.IsRiskyClause)
                    {
                        <div class="card border-warning bg-light mb-3">
                            <div class="card-body">
                                <h6 class="fw-bold text-warning-emphasis mb-3">💡 KHUNG CỐ VẤN ĐÀM PHÁN CHI TIẾT:</h6>

                                <div class="mb-2">
                                    <strong class="text-danger">1. Phân tích điểm thiệt thòi:</strong>
                                    <p class="mb-1 small text-dark">Điều khoản này mập mờ hoặc tạo lợi thế đơn phương cho phía tuyển dụng. Nếu không sửa, bạn sẽ chịu ràng buộc rủi ro khi có tranh chấp.</p>
                                </div>

                                <div class="mb-2">
                                    <strong class="text-success">2. Văn bản đề xuất sửa lại (Drafting):</strong>
                                    <div class="p-2 bg-white border border-success rounded small text-monospace">
                                        <code>"Hai bên thỏa thuận điều chỉnh nội dung điều khoản thành: Cung cấp điều kiện làm việc minh bạch, quyền lợi và trách nhiệm được quy định rõ ràng theo quy định của Bộ luật Lao động."</code>
                                    </div>
                                </div>

                                <div>
                                    <strong class="text-primary">3. Kịch bản thương lượng (Talking Points với HR/Sếp):</strong>
                                    <p class="p-2 bg-white border border-info rounded small mb-0">
                                        <em>"Em rất mong muốn đồng hành lâu dài cùng công ty. Tuy nhiên ở điều khoản này, em đề xuất mình làm rõ hơn các tiêu chí để hai bên dễ làm việc và tránh hiểu lầm về sau ạ."</em>
                                    </p>
                                </div>
                            </div>
                        </div>
                    }

                    <button type="button" class="btn btn-primary w-100 py-2 fw-bold" @onclick="NextQuestion">
                        Câu tiếp theo ➔
                    </button>
                </div>
            </div>
        }
    }
    else
    {
        <!-- Màn hình kết quả đánh giá năng lực -->
        <div class="card shadow text-center p-4">
            <h2 class="fw-bold text-success mb-3">Kết quả Đánh giá Năng lực</h2>
            <div class="display-3 fw-bold my-2 @(totalScore >= 80 ? "text-success" : "text-danger")">
                @totalScore / 100 Điểm
            </div>

            @if (totalScore >= 80)
            {
                <div class="alert alert-success fs-5 my-3">
                    <strong>ĐỦ ĐIỀU KIỆN KÝ HỢP ĐỒNG!</strong><br />
                    Bạn có khả năng nhận diện bẫy pháp lý và tư duy đàm phán rất tốt. Bạn đã sẵn sàng tự tin thương lượng và ký kết hợp đồng ngoài thực tế.
                </div>
            }
            else
            {
                <div class="alert alert-warning fs-5 my-3">
                    <strong>CHƯA ĐỦ ĐIỀU KIỆN KÝ HỢP ĐỒNG!</strong><br />
                    Điểm an toàn của bạn chưa đạt yêu cầu (Tối thiểu 80/100). Bạn nên thực hành đàm phán thêm để tránh gặp rủi ro khi đi làm.
                </div>
            }

            <button type="button" class="btn btn-outline-primary btn-lg mt-2" @onclick="RestartTraining">
                Luyện tập lại từ đầu
            </button>
        </div>
    }
</div>

@code {
    private List<RiskQuestionScenario> scenarios = new();
    private int currentIndex = 0;
    private int totalScore = 0;
    private bool isProcessing = false;
    private bool showFeedback = false;
    private string aiFeedback = "";
    private string userChoice = "";

    protected override void OnInitialized()
    {
        scenarios = SimService.GetTrainingScenarios();
    }

    private async Task HandleUserChoice(string choice)
    {
        isProcessing = true;
        userChoice = choice;
        var currentScenario = scenarios[currentIndex];

        // Lập luận tính điểm:
        // - Nếu điều khoản rủi ro: Lựa chọn "TuChoi" hoặc "DamPhan" đều tính đúng điểm
        // - Nếu điều khoản an toàn: Lựa chọn "DongY" tính đúng điểm
        bool isCorrect = false;
        if (currentScenario.IsRiskyClause)
        {
            isCorrect = (choice == "TuChoi" || choice == "DamPhan");
        }
        else
        {
            isCorrect = (choice == "DongY");
        }

        if (isCorrect)
        {
            totalScore += currentScenario.Points;
        }

        // Chuyển đổi lựa chọn sang dạng boolean để giữ nguyên hàm EvaluateDecisionWithAIAsync của bạn
        bool userAccepted = (choice == "DongY");

        aiFeedback = await SimService.EvaluateDecisionWithAIAsync(
            currentScenario.ClauseText,
            userAccepted,
            currentScenario.IsRiskyClause
        );

        showFeedback = true;
        isProcessing = false;
        StateHasChanged();
    }

    private void NextQuestion()
    {
        showFeedback = false;
        aiFeedback = "";
        userChoice = "";
        currentIndex++;
        StateHasChanged();
    }

    private void RestartTraining()
    {
        currentIndex = 0;
        totalScore = 0;
        aiFeedback = "";
        userChoice = "";
        showFeedback = false;
    }
}
