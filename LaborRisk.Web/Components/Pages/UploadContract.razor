<h3>UploadContract</h3>

@page "/upload-contract"
@using LaborRisk.Domain
@using LaborRisk.LegalEngine
@inject DocumentReaderService DocService
@inject ContractParserAgent ParserAgent
@rendermode InteractiveServer

<PageTitle>Phân tích Hợp đồng từ File</PageTitle>

<div class="container my-4" style="max-width: 800px;">
    <h3 class="fw-bold text-primary mb-3">Tải lên Hợp đồng (Word / PDF) để AI quét lỗi</h3>

    <div class="card p-4 shadow-sm mb-4 border-dashed text-center">
        <InputFile OnChange="LoadFile" accept=".docx, .pdf" class="form-control mb-3" />
        <small class="text-muted">Hỗ trợ định dạng .docx hoặc .pdf</small>
    </div>

    @if (isAnalyzing)
    {
        <div class="alert alert-info d-flex align-items-center">
            <div class="spinner-border spinner-border-sm me-2" role="status"></div>
            <span>AI Qwen2.5 đang đọc file và đối chiếu Bộ luật Lao động 2019...</span>
        </div>
    }

    @if (parsedContract != null)
    {
        <div class="row mt-4">
            <!-- Cột trái: Văn bản hợp đồng được tô đậm rủi ro -->
            <div class="col-md-7">
                <div class="card p-3 shadow-sm">
                    <h5 class="card-title text-primary">📄 Văn bản hợp đồng (Đã quét rủi ro)</h5>
                    <div class="p-3 border rounded bg-light" style="white-space: pre-wrap; max-height: 500px; overflow-y: auto;">
                        @((MarkupString)GetHighlightedContractText())
                    </div>
                </div>
            </div>

            <!-- Cột phải: Gợi ý chiến lược đàm phán -->
            <div class="col-md-5">
                <h5 class="text-danger mb-3">💡 Gợi ý chiến lược đàm phán</h5>
                @if (parsedContract.Clauses != null)
                {
                    @foreach (var clause in parsedContract.Clauses)
                    {
                        <div class="card mb-3 border-warning shadow-sm">
                            <div class="card-header bg-warning text-dark font-weight-bold">
                                @clause.ClauseTitle - <span class="badge bg-danger">@clause.Decision</span>
                            </div>
                            <div class="card-body">
                                <p class="mb-1"><strong>Nội dung gốc:</strong> <em>"@clause.OriginalText"</em></p>
                                <p class="mb-2"><strong>Căn cứ:</strong> @clause.LegalReference</p>

                                @if (clause.Strategy != null)
                                {
                                    <hr class="my-2" />
                                    <p class="text-danger mb-1"><strong>Lý do nên đàm phán:</strong> @clause.Strategy.WhyNegotiate</p>
                                    <p class="text-success mb-1"><strong>Đề xuất sửa lại:</strong> @clause.Strategy.ProposedText</p>
                                    <p class="text-info mb-0"><strong>Lời nói gợi ý với Sếp/HR:</strong> @clause.Strategy.TalkingPoints</p>
                                }
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    }
</div>

@code {
    private bool isAnalyzing = false;
    private string analysisResult = "";
    private string rawText = "";
    private ContractAnalysisResult? parsedContract; 

    private string GetHighlightedContractText()
    {
        if (string.IsNullOrEmpty(rawText) || parsedContract?.Clauses == null)
            return rawText ?? "";

        string highlightedText = rawText;

        foreach (var clause in parsedContract.Clauses)
        {
            if (!string.IsNullOrWhiteSpace(clause.OriginalText) && highlightedText.Contains(clause.OriginalText))
            {
                // Tô đậm đoạn văn bản rủi ro bằng màu vàng
                string replacement = $"<mark style='background-color: #ffeb3b; font-weight: bold; padding: 2px 4px; border-radius: 3px;'>{clause.OriginalText}</mark>";
                highlightedText = highlightedText.Replace(clause.OriginalText, replacement);
            }
        }

        return highlightedText;
    }

    private async Task LoadFile(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        isAnalyzing = true;
        analysisResult = "";
        StateHasChanged();

        try
        {
            // Giới hạn file tối đa 10MB
            using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            ms.Position = 0;

            // 1. Đọc nội dung văn bản từ Stream
            string textContent = DocService.ExtractTextFromStream(ms, file.Name);

            if (!string.IsNullOrWhiteSpace(textContent))
            {
                rawText = textContent; 
                // 2. Gọi AI bóc tách dữ liệu hợp đồng
                var parsedContract = await ParserAgent.ExtractDataAsync(textContent);
                // 3. Cho LegalRuleEngine đánh giá các rủi ro
                var ruleEngine = new LegalRuleEngine();
                var assessment = ruleEngine.EvaluateContract(parsedContract);

                // 4. Hiển thị kết quả rủi ro
                if (assessment.Risks != null && assessment.Risks.Count > 0)
                {
                    analysisResult = string.Join("\n\n", assessment.Risks.Select(r => $" {r.Description}"));
                }
                else
                {
                    analysisResult = "Hợp đồng không phát hiện điều khoản rủi ro nghiêm trọng theo Bộ luật Lao động 2019.";
                }
            }
            else
            {
                analysisResult = "Không thể đọc được nội dung từ file đã tải lên.";
            }
        }
        finally
        {
            isAnalyzing = false;
            StateHasChanged();
        }
    }
}
