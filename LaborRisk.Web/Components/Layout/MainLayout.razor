@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <a href="https://learn.microsoft.com/aspnet/core/" target="_blank">About</a>
        </div>

        <article class="content px-4">
            @Body
            <footer class="mt-4 pt-3 border-top text-center text-muted small">
                <p>⚠️ <strong>Miễn trừ trách nhiệm:</strong> Kết quả phân tích được tạo tự động bởi mô hình AI local (Qwen 2.5). Thông tin chỉ mang tính chất tham khảo cho quá trình đàm phán, không thay thế cho tư vấn pháp lý chính thức từ Luật sư.</p>
            </footer>
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>
